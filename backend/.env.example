# Valores de exemplo para desenvolvimento local; nunca use como credenciais de produção.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gymnotes_db
DB_USER=postgres
DB_PASSWORD=replace_with_local_database_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_random_secret_at_least_32_bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=gymnotes-media
STORAGE_ACCESS_KEY=replace_with_storage_access_key
STORAGE_SECRET_KEY=replace_with_storage_secret_key
